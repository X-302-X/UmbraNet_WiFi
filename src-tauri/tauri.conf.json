{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UmbraNet_WiFi",
  "version": "0.1.0",
  "identifier": "org.umbranet.wifi",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "UmbraNet_WiFi",
        "width": 1120,
        "height": 740,
        "minWidth": 780,
        "minHeight": 560,
        "resizable": true,
        "decorations": true,
        "transparent": true,
        "backgroundColor": [
          0,
          0,
          0,
          0
        ]
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost https://ipc.localhost; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "../core/dpi/driver/WinDivert.dll": "core/dpi/driver/WinDivert.dll",
      "../core/dpi/driver/WinDivert64.sys": "core/dpi/driver/WinDivert64.sys",
      "../core/dpi/driver/NOTICE.txt": "core/dpi/driver/NOTICE.txt",
      "../core/dpi/driver/LICENSE-WinDivert.txt": "core/dpi/driver/LICENSE-WinDivert.txt"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "installerHooks": "windows/installer-hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
