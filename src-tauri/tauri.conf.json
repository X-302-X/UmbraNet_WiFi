{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UmbraNet_WiFi",
  "version": "0.1.0",
  "identifier": "org.umbranet.wifi",
  "build": { "frontendDist": "../ui" },
  "app": {
    "windows": [{
      "title": "UmbraNet_WiFi",
      "width": 1120,
      "height": 740,
      "minWidth": 780,
      "minHeight": 560,
      "resizable": true,
      "decorations": true,
      "transparent": true,
      "backgroundColor": [0, 0, 0, 0]
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'none'; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
