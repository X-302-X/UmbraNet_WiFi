{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UmbraNet Setup",
  "version": "0.1.0",
  "identifier": "org.umbranet.wifi.setup",
  "build": { "frontendDist": "../ui" },
  "app": {
    "windows": [{
      "title": "Установка UmbraNet",
      "width": 1010,
      "height": 650,
      "minWidth": 740,
      "minHeight": 560,
      "resizable": true,
      "decorations": false,
      "transparent": true,
      "backgroundColor": [0, 0, 0, 0]
    }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost https://ipc.localhost; object-src 'none'; base-uri 'none'" }
  },
  "bundle": { "active": false, "icon": ["../../icons/icon.ico"] }
}
